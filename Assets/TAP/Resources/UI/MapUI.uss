/* Map view overlay: markers and node handles placed from code; the info unit bottom left, the maneuver node unit
   bottom right (both Flight Deck units that HudLayout moves), a click menu at the pointer. */
.map-marker {
    position: absolute;
    width: 26px;
    height: 26px;
    translate: -50% -50%;
}

.map-marker__icon {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.map-marker__label {
    position: absolute;
    left: 24px;
    top: 4px;
    width: 140px;
    font-size: 13px;
    white-space: nowrap;
}

.map-add {
    position: absolute;
    width: 22px;
    height: 22px;
    translate: -50% -50%;
    -unity-background-image-tint-color: rgba(77, 153, 255, 0.9);
    -unity-background-scale-mode: scale-to-fit;
}

.map-handle {
    position: absolute;
    width: 30px;
    height: 30px;
    translate: -50% -50%;
}

.btn.node-delete {
    position: absolute;
    width: 26px;
    height: 26px;
    padding: 0;
    translate: -50% -50%;
    font-size: 20px;
}

.map-hint {
    position: absolute;
    left: 50%;
    top: 142px;
    width: 1400px;
    translate: -50% 0;
    -unity-text-align: middle-center;
    font-size: 14px;
}

/* the info and node units: HudLayout places them (bottom left and bottom right by default) */
.fd-unit.map-unit {
    padding: 12px;
}

#orbit-panel {
    width: 380px;
}

.map-info {
    font-size: 13px;
}

.btn.track-toggle {
    margin-left: auto;
    height: 20px;
    padding: 0 8px;
    font-size: 11px;
}

/* the ground-track unit: wide enough for the 520x260 picture (GroundTrackView) inside its padding and border */
#track-panel {
    width: 546px;
}

.track-row {
    margin-top: 7px;
}

.track-orbitbtn {
    width: 40px;
    height: 24px;
    margin-right: 4px;
    padding: 0;
    font-size: 12px;
}

.gt-mark {
    position: absolute;
    translate: -50% -50%;
}

#node-panel {
    width: 450px;
}

.node-head {
    margin-bottom: 8px;
}

.node-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.node-label {
    width: 52px;
}

.node-component {
    width: 92px;
    font-size: 13px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
}

.node-step {
    width: 34px;
    height: 28px;
    padding: 0;
    font-size: 17px;
}

.node-field {
    width: 130px;
    height: 28px;
    margin: 0 4px;
}

.node-field > .unity-base-text-field__input {
    -unity-text-align: middle-right;
    font-size: 14px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
}

.node-unit {
    margin-left: 6px;
    font-size: 12px;
}

.node-stepbtn {
    width: 50px;
    height: 24px;
    margin-right: 4px;
    font-size: 12px;
}

.node-step-text {
    margin-left: 6px;
    font-size: 13px;
}

.node-timebtn {
    width: 44px;
    height: 24px;
    margin-right: 3px;
    padding: 0;
    font-size: 11px;
}

.node-action {
    flex-grow: 1;
    flex-basis: 0;
    height: 28px;
    margin-right: 6px;
    font-size: 12px;
}

.node-action--last {
    margin-right: 0;
}

.node-text {
    font-size: 13px;
}

/* the click menu at the pointer */
.fd-unit.map-context {
    width: 240px;
    padding: 10px;
}

.context-head {
    margin-bottom: 6px;
}

.context-title {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.context-btn {
    height: 28px;
    margin-bottom: 4px;
    font-size: 13px;
}
