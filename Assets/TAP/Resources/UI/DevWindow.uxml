<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="FlightDeck.uss" />
    <ui:Style src="FlightPanels.uss" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement name="dev-window" class="fd-unit">
            <ui:VisualElement class="fd-row dev-head">
                <ui:Label name="dev-title" class="fd-head-title dev-title" text="DEVELOPER TOOLS" />
                <ui:Label name="dev-cheats" class="dev-cheats" picking-mode="Ignore" text="CHEATS ON" />
                <ui:TextField name="dev-search" class="field dev-search" />
                <ui:Button name="dev-close" class="btn fd-x" text="×" />
            </ui:VisualElement>
            <ui:VisualElement class="dev-body">
                <ui:ScrollView name="dev-tabs" class="dev-tabs" />
                <ui:ScrollView name="dev-pages" class="list dev-pages" />
            </ui:VisualElement>
            <ui:Label name="dev-status" class="dev-status no-loc" picking-mode="Ignore" />
            <ui:VisualElement name="dev-grip" class="dev-grip" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
