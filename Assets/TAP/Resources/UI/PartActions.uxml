<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="FlightPanels.uss" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement name="part-window" class="panel hidden">
            <ui:VisualElement class="part-head">
                <ui:Label name="part-title" class="part-title" />
                <ui:Button name="part-close" class="btn part-close" text="×" />
            </ui:VisualElement>
            <ui:Label name="part-info" class="part-info wrap" picking-mode="Ignore" />
            <ui:VisualElement name="part-actions" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
