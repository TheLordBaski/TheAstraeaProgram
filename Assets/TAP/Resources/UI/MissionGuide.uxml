<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="FlightDeck.uss" />
    <ui:Style src="FlightPanels.uss" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement name="guide" class="fd-unit">
            <ui:VisualElement class="fd-glass guide-glass">
                <ui:VisualElement class="fd-row fd-page-head guide-head">
                    <ui:Label name="guide-title" class="fd-head-title guide-title" />
                    <ui:Button name="guide-set" class="btn fd-key guide-toggle" text="»" />
                    <ui:Button name="guide-toggle" class="btn fd-key guide-toggle" text="–" />
                </ui:VisualElement>
                <ui:Label name="guide-text" class="guide-text wrap" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
