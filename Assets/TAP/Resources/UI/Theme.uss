/* TAP game UI theme: the Flight Deck look (bezelled hardware units, night glass, lit keys) as tokens and shared classes.
   Colours match UIKit's constants (they are also used in rich text from code) and the flight HUD's FlightDeck.uss. */
:root {
    --c-panel: rgb(29, 33, 38);
    --c-bezel-hi: rgb(62, 70, 79);
    --c-bezel-side: rgb(44, 50, 57);
    --c-bezel-lo: rgb(20, 23, 27);
    --c-bezel-shadow: rgb(10, 12, 14);
    --c-glass: rgb(4, 6, 7);
    --c-glass-edge: rgb(40, 47, 53);
    --c-row: rgb(12, 16, 19);
    --c-row-edge: rgb(28, 39, 45);
    --c-accent: rgb(94, 230, 242);
    --c-accent-dim: rgb(46, 118, 126);
    --c-text: rgb(218, 225, 229);
    --c-text-dim: rgb(127, 140, 149);
    --c-good: rgb(72, 226, 124);
    --c-warn: rgb(255, 181, 71);
    --c-bad: rgb(255, 74, 61);
    --c-button: rgb(42, 48, 55);
    --c-button-hover: rgb(54, 62, 71);
    --c-dim-screen: rgba(0, 0, 0, 0.55);

    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Regular.ttf");
    color: var(--c-text);
    font-size: 17px;
}

/* full-screen layer that lets clicks through to the world */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* a hardware unit: bezel with a lit top edge */
.panel {
    background-color: var(--c-panel);
    border-width: 1px;
    border-top-color: var(--c-bezel-hi);
    border-left-color: var(--c-bezel-side);
    border-right-color: var(--c-bezel-lo);
    border-bottom-color: var(--c-bezel-shadow);
    border-radius: 10px;
}

/* a row or tile on the glass */
.panel--light {
    background-color: var(--c-row);
    border-color: var(--c-row-edge);
    border-radius: 4px;
}

/* night glass */
.panel--deep {
    background-color: var(--c-glass);
    border-color: var(--c-glass-edge);
    border-radius: 6px;
}

.panel--plain {
    border-width: 0;
}

.abs {
    position: absolute;
}

.row {
    flex-direction: row;
    align-items: center;
}

.grow {
    flex-grow: 1;
}

.hidden {
    display: none;
}

/* text */
.text-dim {
    color: var(--c-text-dim);
}

.text-accent {
    color: var(--c-accent);
}

.text-warn {
    color: var(--c-warn);
}

.text-good {
    color: var(--c-good);
}

.text-bad {
    color: var(--c-bad);
}

.bold {
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
}

.wrap {
    white-space: normal;
}

.nowrap {
    white-space: nowrap;
}

.title {
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    color: var(--c-accent);
    font-size: 14px;
    letter-spacing: 1px;
}

Label {
    padding: 0;
    margin: 0;
}

/* buttons are hardware keys. Buttons lose Unity's own .unity-button class in UIKit.Prepare, so only these rules style them */
.btn {
    background-color: var(--c-button);
    border-width: 1px 1px 2px 1px;
    border-top-color: rgb(70, 79, 89);
    border-left-color: rgb(34, 39, 45);
    border-right-color: rgb(24, 28, 32);
    border-bottom-color: rgb(9, 11, 13);
    border-radius: 4px;
    margin: 0;
    padding: 0 6px;
    color: var(--c-text);
    font-size: 15px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: background-color, color;
    transition-duration: 0.08s;
}

.btn:hover {
    background-color: var(--c-button-hover);
}

.btn:active {
    translate: 0 1px;
    border-bottom-width: 1px;
}

/* engaged: the key's top edge lights up */
.btn.on {
    border-top-width: 3px;
    border-top-color: var(--c-good);
    color: rgb(233, 255, 240);
}

.btn:disabled {
    color: rgb(86, 95, 103);
    background-color: rgb(34, 39, 44);
}

.btn--clear {
    background-color: rgba(0, 0, 0, 0.01);
    border-width: 0;
}

.btn--clear:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.btn--go {
    background-color: rgb(30, 84, 52);
    border-top-color: rgb(58, 132, 86);
    border-left-color: rgb(26, 70, 44);
    border-right-color: rgb(18, 50, 32);
    color: rgb(233, 255, 240);
}

.btn--go:hover {
    background-color: rgb(38, 104, 64);
}

.btn__icon {
    position: absolute;
    left: 4px;
    top: 4px;
    right: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

/* bars: a dark track with a coloured fill sized from code */
.bar {
    background-color: var(--c-glass);
    border-width: 1px;
    border-color: var(--c-glass-edge);
    border-radius: 3px;
    padding: 1px;
}

.bar__fill {
    background-color: var(--c-accent);
    border-radius: 2px;
    height: 100%;
}

.bar--vertical {
    flex-direction: column-reverse;
}

.bar--vertical > .bar__fill {
    width: 100%;
    height: auto;
}

/* text fields: glass */
.field {
    margin: 0;
    padding: 0;
}

.field > .unity-base-text-field__input {
    background-color: var(--c-glass);
    border-width: 1px;
    border-color: var(--c-glass-edge);
    border-radius: 4px;
    padding: 2px 8px;
    color: rgb(238, 243, 245);
    font-size: 16px;
    --unity-cursor-color: var(--c-accent);
    --unity-selection-color: rgba(94, 230, 242, 0.3);
    -unity-text-align: middle-left;
}

.field:focus > .unity-base-text-field__input {
    border-color: var(--c-accent-dim);
}

.field .unity-text-element--placeholder {
    color: var(--c-text-dim);
}

/* scroll lists sit on the glass */
.list {
    background-color: var(--c-glass);
    border-width: 1px;
    border-color: var(--c-glass-edge);
    border-radius: 4px;
}

.list .unity-scroll-view__content-container {
    padding: 4px;
}

.unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 0;
    border-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--c-accent-dim);
    border-width: 0;
    border-radius: 4px;
    left: 1px;
    width: 6px;
}

/* modal dialogs: a dimmed screen with a centred unit */
.dialog {
    background-color: var(--c-dim-screen);
    align-items: center;
    justify-content: center;
}

.dialog__panel {
    padding: 12px 16px 16px;
}

.dialog__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--c-bezel-lo);
}

.dialog__title {
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    color: var(--c-accent);
    font-size: 18px;
    letter-spacing: 1px;
}

.dialog__close {
    width: 84px;
    height: 30px;
    font-size: 14px;
}

/* tooltip: a slip of glass */
.tooltip {
    position: absolute;
    max-width: 400px;
    padding: 7px 10px;
    background-color: rgba(4, 6, 7, 0.97);
    border-width: 1px;
    border-color: var(--c-glass-edge);
    border-radius: 4px;
    font-size: 14px;
    white-space: normal;
}
