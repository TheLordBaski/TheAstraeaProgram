<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="menu" class="screen" picking-mode="Ignore">
        <ui:Label name="title" class="menu-title" picking-mode="Ignore" text="&lt;size=46&gt;THE&lt;/size&gt; ASTRAEA &lt;size=46&gt;PROGRAM&lt;/size&gt;" />
        <ui:Label name="subtitle" class="menu-subtitle" picking-mode="Ignore" text="" />
        <ui:VisualElement name="buttons" class="menu-buttons">
            <ui:Button name="continue" class="btn menu-btn btn--go" />
            <ui:Button name="new" class="btn menu-btn" text="New sandbox" />
            <ui:Button name="load" class="btn menu-btn" text="Load game" />
            <ui:Button name="controls" class="btn menu-btn" text="Controls" />
            <ui:Button name="settings" class="btn menu-btn" text="Settings" />
            <ui:Button name="report" class="btn menu-btn" text="Report a problem" />
            <ui:Button name="quit" class="btn menu-btn" text="Quit" />
        </ui:VisualElement>
        <ui:Button name="data-notice" class="btn menu-notice hidden" />
        <ui:Label name="footer" class="menu-footer text-dim" picking-mode="Ignore" />

        <ui:VisualElement name="new-dialog" class="screen dialog hidden">
            <ui:VisualElement class="panel dialog__panel new-panel">
                <ui:VisualElement class="dialog__head">
                    <ui:Label class="dialog__title" text="NEW SANDBOX" />
                    <ui:Button class="btn dialog__close" text="Close" />
                </ui:VisualElement>
                <ui:Label text="Save name:" />
                <ui:TextField name="new-name" class="field new-name" />
                <ui:Label class="text-dim wrap new-info" text="Starts with an empty universe, 8 rocketeers and three tested starter rockets in the assembly building." />
                <ui:Button name="new-start" class="btn btn--go new-start" text="Start" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="load-dialog" class="screen dialog hidden">
            <ui:VisualElement class="panel dialog__panel load-panel">
                <ui:VisualElement class="dialog__head">
                    <ui:Label class="dialog__title" text="LOAD GAME" />
                    <ui:Button class="btn dialog__close" text="Close" />
                </ui:VisualElement>
                <ui:ScrollView name="load-list" class="list grow" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="controls-dialog" class="screen dialog hidden">
            <ui:VisualElement class="panel dialog__panel controls-panel">
                <ui:VisualElement class="dialog__head">
                    <ui:Label class="dialog__title" text="CONTROLS" />
                    <ui:Button class="btn dialog__close" text="Close" />
                </ui:VisualElement>
                <ui:ScrollView name="controls-list" class="list grow" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="data-dialog" class="screen dialog hidden">
            <ui:VisualElement class="panel dialog__panel data-panel">
                <ui:VisualElement class="dialog__head">
                    <ui:Label class="dialog__title" text="GAME DATA PROBLEMS" />
                    <ui:Button class="btn dialog__close" text="Close" />
                </ui:VisualElement>
                <ui:ScrollView name="data-list" class="list grow">
                    <ui:Label name="data-text" class="wrap data-text" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
