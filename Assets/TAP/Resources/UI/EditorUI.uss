/* Assembly building (Flight Deck look): top bar, parts palette on the left, engineer's report + warnings + staging
   down the right, hint bar at the bottom, toasts under the top bar. */

/* top bar */
#top-bar {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 8px;
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding: 0 7px;
}

.bar-title {
    width: 100px;
    -unity-text-align: middle-center;
    font-size: 16px;
}

.bar-name {
    width: 240px;
    height: 38px;
    margin-right: 6px;
}

.bar-name > .unity-base-text-field__input {
    font-size: 18px;
}

.bar-btn {
    min-width: 62px;
    padding: 0 8px;
    height: 38px;
    margin-right: 6px;
    font-size: 14px;
}

.bar-gap {
    width: 4px;
}

.bar-sym {
    min-width: 118px;
    padding: 0 8px;
}

.bar-snap {
    min-width: 104px;
    padding: 0 8px;
}

.bar-markers {
    min-width: 112px;
    padding: 0 8px;
}

.bar-env {
    min-width: 140px;
    padding: 0 8px;
}

.bar-flights {
    min-width: 90px;
    padding: 0 8px;
}

.bar-hub {
    min-width: 130px;
    padding: 0 8px;
}

.bar-launch {
    min-width: 130px;
    letter-spacing: 2px;
    padding: 0 8px;
    margin-right: 0;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
}

/* parts palette */
#palette {
    position: absolute;
    left: 8px;
    top: 68px;
    bottom: 8px;
    width: 348px;
    padding: 8px 6px 6px;
}

.palette-title {
    margin: 0 0 6px 4px;
}

.categories {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.category {
    width: 32%;
    height: 32px;
    margin: 0 1% 4px 0;
    font-size: 13px;
}

.palette-search {
    height: 32px;
    margin-bottom: 8px;
}

.palette-search > .unity-base-text-field__input {
    font-size: 16px;
}

.palette-tiles {
    flex-grow: 1;
}

.palette-tiles .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.btn.tile {
    width: 32%;
    height: 124px;
    margin: 0 1% 4px 0;
    padding: 4px 3px 3px;
    align-items: center;
    justify-content: space-between;
    background-color: var(--c-row);
    border-width: 1px;
    border-color: var(--c-row-edge);
    border-radius: 4px;
    translate: 0 0;
}

.btn.tile:hover {
    background-color: rgb(18, 27, 31);
    border-color: var(--c-accent-dim);
}

.tile__thumb {
    width: 84px;
    height: 84px;
}

.tile__name {
    height: 32px;
    width: 100px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Regular.ttf");
    font-size: 11px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* right column: report, warnings, staging (the staging list takes what is left) */
#right-column {
    position: absolute;
    right: 8px;
    top: 68px;
    bottom: 16px;
    width: 392px;
}

#engineer {
    flex-shrink: 0;
    margin-bottom: 6px;
    padding: 6px 8px 8px 8px;
}

#engineer > .title {
    height: 22px;
    margin: 0 0 0 4px;
    padding: 0;
    -unity-text-align: middle-left;
}

.stats {
    margin: 0;
    padding: 0;
    font-size: 14px;
}

#warnings {
    flex-shrink: 0;
    max-height: 230px;
    margin-bottom: 6px;
    padding: 8px;
    overflow: hidden;
}

.warnings-text {
    margin: 0;
    padding: 0;
    font-size: 13px;
}

#staging {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    padding: 6px;
}

.staging-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 2px 2px 6px 6px;
}

.staging-head > .title {
    margin: 0;
    padding: 0;
}

.staging-reset {
    width: 76px;
    height: 26px;
    font-size: 14px;
}

.stages {
    flex-grow: 1;
}

.list .text-dim {
    margin: 6px 4px;
    font-size: 13px;
}

.staging-hint {
    height: 34px;
    margin-top: 2px;
    -unity-text-align: middle-center;
    font-size: 13px;
}

/* 2px border + 4px padding = the original 6px inset; header 20 + 2 + one 48px icon row */
.stage-block {
    padding: 4px;
}

.stage-block.drop-target {
    border-color: var(--c-accent);
}

.stage-block__head {
    height: 20px;
    margin: 0 0 2px 0;
    padding: 0;
    -unity-text-align: middle-left;
    font-size: 13px;
}

.stage-icons {
    flex-direction: row;
    flex-wrap: wrap;
}

.stage-icon {
    width: 44px;
    height: 44px;
    margin: 0 4px 4px 0;
    border-width: 1px;
    border-color: var(--c-glass-edge);
    border-radius: 4px;
    background-color: rgb(24, 30, 35);
}

.stage-icon__glyph {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
}

.stage-icon__badge {
    position: absolute;
    right: 3px;
    bottom: 1px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    font-size: 12px;
}

.stage-insert {
    height: 8px;
    margin: 2px 0;
    border-radius: 3px;
}

.stage-insert.drop-target {
    background-color: rgba(94, 230, 242, 0.6);
}

.stage-ghost {
    position: absolute;
    opacity: 0.8;
    translate: -50% -50%;
}

/* hint bar and toast */
/* between the palette and the right column */
#hint-bar {
    position: absolute;
    left: 366px;
    right: 410px;
    bottom: 8px;
    height: 34px;
    padding: 0 8px;
    justify-content: center;
}

.hint {
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-text-auto-size: best-fit 9px 13px;
}

.toast {
    position: absolute;
    left: 50%;
    top: 80px;
    width: 1000px;
    margin-left: -16px;
    translate: -50% 0;
    -unity-text-align: upper-center;
    font-size: 19px;
    text-shadow: 1.5px 1.5px 0 rgba(0, 0, 0, 0.8);
}

/* part menu (at the pointer) */
.part-menu {
    position: absolute;
    width: 360px;
    padding: 10px 12px 8px;
}

.part-menu-glass {
    margin-bottom: 8px;
}

.part-menu-text {
    font-size: 13px;
}

.part-menu-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin-bottom: 4px;
}

.part-menu-label {
    width: 150px;
    font-size: 14px;
}

.part-menu-step {
    width: 42px;
    height: 30px;
    margin-right: 4px;
    padding: 0;
    font-size: 14px;
}

.part-menu-btn {
    height: 30px;
    margin-bottom: 4px;
    font-size: 14px;
}

/* dialogs */
.editor-dialog {
    background-color: rgba(0, 0, 0, 0.45);
}

.help-panel {
    width: 760px;
    height: 640px;
}

.help-text {
    font-size: 15px;
}

.load-panel {
    width: 760px;
    height: 620px;
}

.flights-panel {
    width: 700px;
    height: 520px;
}

.list-section {
    height: 26px;
    margin-bottom: 6px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    color: var(--c-accent);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.list-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 4px 8px 4px 10px;
}

.list-row--craft {
    min-height: 74px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.list-row--flight {
    height: 56px;
}

.list-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    white-space: normal;
    overflow: hidden;
}

.list-row__btn {
    width: 82px;
    height: 34px;
    margin-left: 6px;
    font-size: 15px;
}

.btn.list-row__btn--armed {
    background-color: rgb(110, 34, 28);
    border-top-color: rgb(160, 60, 50);
}
