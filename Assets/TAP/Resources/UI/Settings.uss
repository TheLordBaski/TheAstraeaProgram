/* Settings dialog: tabs along the top, one row per setting (label left, control right). */
.settings-panel {
    width: 880px;
    height: 720px;
}

.settings-panel > * {
    flex-shrink: 0;
}

.settings-panel > .unity-scroll-view {
    flex-shrink: 1;
    flex-basis: 0;
}

.settings-tabs {
    flex-direction: row;
    margin-bottom: 10px;
}

.settings-tab {
    width: 150px;
    height: 36px;
    margin-right: 6px;
    font-size: 14px;
    letter-spacing: 1px;
}

.set-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 8px;
}

.set-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.set-label {
    width: 330px;
    font-size: 16px;
}

.set-control {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.set-step {
    width: 36px;
    height: 32px;
    font-size: 22px;
    padding-bottom: 3px;
}

.set-value {
    width: 190px;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-text-auto-size: best-fit 10px 16px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    color: rgb(238, 243, 245);
}

.set-value--narrow {
    width: 80px;
}

.set-slider {
    width: 300px;
    margin: 0 8px;
}

.set-slider .unity-base-slider__tracker {
    background-color: var(--c-glass);
    border-width: 1px;
    border-color: var(--c-glass-edge);
    border-radius: 3px;
    height: 6px;
}

.set-slider .unity-base-slider__dragger {
    background-color: var(--c-accent);
    border-width: 0;
    border-radius: 9px;
    width: 18px;
    height: 18px;
}

.set-label--wide {
    width: 450px;
    font-size: 15px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.set-bind {
    width: 230px;
    height: 32px;
    margin-right: 8px;
    font-size: 14px;
}

.set-reset {
    width: 84px;
    font-size: 14px;
}

.set-heading {
    margin: 14px 0 4px 8px;
    -unity-font-definition: url("/Assets/TAP/Fonts/B612-Bold.ttf");
    color: var(--c-accent);
    font-size: 14px;
    letter-spacing: 1px;
}

.set-wide {
    height: 38px;
    margin: 6px 8px;
    font-size: 16px;
}

.set-toggle {
    width: 120px;
    height: 32px;
    font-size: 14px;
}

.settings-note {
    margin-top: 8px;
    font-size: 15px;
}

.settings-reset {
    align-self: flex-end;
    width: 220px;
    height: 38px;
    margin-top: 8px;
    font-size: 16px;
}
