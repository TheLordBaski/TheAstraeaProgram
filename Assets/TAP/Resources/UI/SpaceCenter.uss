/* Space center: a top bar, a marker over each building, and the tracking station list. */
.hub-bar {
    position: absolute;
    left: 24px;
    top: 20px;
    right: 24px;
    height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px 0 20px;
}

.hub-title {
    -unity-font-style: bold;
    font-size: 24px;
    color: var(--c-accent);
    letter-spacing: 4px;
}

.hub-info {
    margin-left: 24px;
    font-size: 17px;
}

.hub-btn {
    width: 130px;
    height: 38px;
    margin-left: 8px;
    font-size: 16px;
}

.hub-marker {
    position: absolute;
    translate: -50% -50%;
    min-width: 230px;
    height: 62px;
    padding: 0 16px;
    background-color: var(--c-panel);
    border-width: 2px;
    border-color: var(--c-border);
    border-radius: 8px;
    font-size: 18px;
}

.hub-marker:hover,
.hub-marker.on {
    background-color: var(--c-button-active);
    border-color: var(--c-accent);
}

.hub-marker:disabled {
    background-color: var(--c-panel);
}

.hub-note {
    position: absolute;
    left: 50%;
    bottom: 40px;
    translate: -50% 0;
    max-width: 900px;
    padding: 10px 18px;
    font-size: 18px;
}

.tracking-panel {
    width: 760px;
    height: 520px;
}

.tracking-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin-bottom: 6px;
    padding: 0 8px 0 12px;
}

.tracking-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 18px;
    white-space: nowrap;
    overflow: hidden;
}

.tracking-row__btn {
    width: 110px;
    height: 38px;
    margin-left: 6px;
    font-size: 16px;
}
