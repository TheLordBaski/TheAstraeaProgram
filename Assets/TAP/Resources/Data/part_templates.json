  "manufacturers": [
    {"id": "Astraea Works", "personality": "The agency's own workshop. Plain, sturdy and cheap: tanks, couplings, ladders. Its descriptions say what the part does and nothing else."},
    {"id": "Corvid Aerospace", "personality": "Pods, probes, fins, chutes. Light, clever, a little too optimistic: its parts are the first to be cut to save grams."},
    {"id": "Vance Propulsion", "personality": "Engines and boosters. Thrust first, manners later: loud, powerful, over-engineered, always a point or two of Isp ahead of the brochure."},
    {"id": "Lumen Instruments", "personality": "Instruments, panels, antennas, lights. Precise to a fault, fussy about calibration, and the only maker that gives error bars."},
    {"id": "Vantor Heavy Works", "personality": "Big tanks, heavy engines, structure. Slow, massive and conservative: nothing leaves the factory that could not survive a worse day."},
    {"id": "Quiet Star Labs", "personality": "Nuclear, ion, power and mining equipment. Experimental and quietly brilliant; the manual is always one revision behind the part."}
  ],
